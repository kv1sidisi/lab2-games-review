    "\n",
    "    test_gram = (final_train.T @ final_train).tocsc()\n",
    "    weights = fit_itemknn(test_gram, best_neighbors)\n",
    "    collaborative[\"ItemKNN\"] = recommend(\n",
    "        test_context, lambda batch: (batch @ weights).toarray(),\n",
    "        test_popularity, known_catalog,\n",
    "    )\n",
    "    del test_gram, weights\n",
    "\n",
    "    baseline_svd = svd_recommend(\n",
    "        final_train, test_context, 32, False, test_popularity, known_catalog\n",
    "    )\n",
    "    if best_rank == 32 and not use_l2:\n",
    "        collaborative[\"TruncatedSVD\"] = baseline_svd\n",
    "    else:\n",
    "        collaborative[\"TruncatedSVD\"] = svd_recommend(\n",
    "            final_train, test_context, best_rank, use_l2, test_popularity, known_catalog\n",
    "        )\n",
    "    del final_train\n",
    "\n",
    "    content_warm = recommend(warm_context, content_scores, test_popularity, known_catalog)\n",
    "    content_full = recommend(test_context, content_scores, test_popularity, full_catalog)\n",
    "\n",
    "for lists in (*collaborative.values(), baseline_svd):\n",
    "    check_recommendations(lists, test_context, known_catalog)\n",
    "check_recommendations(content_warm, warm_context, known_catalog)\n",
    "check_recommendations(content_full, test_context, full_catalog)\n",
    "\n",
    "known_size = int(known_catalog.sum())\n",
    "print(f\"Каталог с обучающей историей: {known_size:,} товаров из {n_items:,}.\")\n",
    "print(f\"Знакомые цели: {test_warm.sum():,} из {len(test_targets):,} сессий.\")\n",
    "print(f\"Холодные цели: {test_cold.sum():,} из {len(test_targets):,} сессий ({test_cold.mean():.2%}).\")"
   ]
  },
