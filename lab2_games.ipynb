    "def recommend(context, score_batch, popularity, allowed):\n",
    "    priority = np.lexsort((item_ids, -popularity))\n",
    "    priority = priority[allowed[priority]]\n",
    "    if len(priority) < K:\n",
    "        raise ValueError(\"В каталоге меньше десяти кандидатов.\")\n",
    "\n",
    "    priority_position = np.full(n_items, -1, dtype=np.int32)\n",
    "    priority_position[priority] = np.arange(len(priority))\n",
    "    recommendations = np.empty((context.shape[0], K), dtype=np.int32)\n",
    "\n",
    "    for start in range(0, context.shape[0], BATCH_SIZE):\n",
    "        batch = context[start:start + BATCH_SIZE]\n",
    "        scores = np.ascontiguousarray(score_batch(batch)[:, priority])\n",
    "        rows, columns = batch.nonzero()\n",
    "        blocked = priority_position[columns]\n",
    "        eligible = blocked >= 0\n",
    "        scores[rows[eligible], blocked[eligible]] = -np.inf\n",
    "\n",
    "        boundaries = np.partition(scores, -K, axis=1)[:, -K]\n",
    "        if not np.isfinite(boundaries).all():\n",
    "            raise ValueError(\"В сессии меньше десяти допустимых рекомендаций.\")\n",
    "\n",
    "        for offset, boundary in enumerate(boundaries):\n",
    "            row = scores[offset]\n",
    "            higher = np.flatnonzero(row > boundary)\n",
    "            tied = np.flatnonzero(row == boundary)[:K - len(higher)]\n",
    "            chosen = np.concatenate((higher, tied))\n",
    "            order = np.argsort(-row[chosen], kind=\"stable\")\n",
    "            recommendations[start + offset] = priority[chosen[order]]\n",
    "\n",
    "    return recommendations"
   ]
  },
