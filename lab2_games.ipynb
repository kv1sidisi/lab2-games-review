   "source": [
    "lengths = sessions[\"n_views\"]\n",
    "length_limit = int(np.ceil(lengths.quantile(0.99)))\n",
    "length_counts = lengths.clip(upper=length_limit).value_counts().sort_index()\n",
    "purchase_counts = sessions[\"target_item\"].value_counts().reindex(item_ids, fill_value=0)\n",
    "purchase_curve = purchase_counts.sort_values(ascending=False).cumsum() / len(sessions)\n",
    "top_items = max(1, int(np.ceil(n_items * 0.01)))\n",
    "head_purchase_share = purchase_curve.iloc[top_items - 1]\n",
    "\n",
    "fig, (left, right) = plt.subplots(1, 2, figsize=(10.8, 3.6), layout=\"constrained\")\n",
    "left.bar(length_counts.index, length_counts / len(sessions), color=\"#287468\")\n",
    "left.set(\n",
    "    xlabel=\"Просмотров за сессию\",\n",
    "    ylabel=\"Доля сессий\",\n",
    "    title=f\"Последний столбец — {length_limit} и больше\",\n",
    ")\n",
    "left.yaxis.set_major_formatter(PercentFormatter(1))\n",
    "right.plot(np.arange(1, n_items + 1), purchase_curve, color=\"#7060A0\")\n",
    "right.axvline(top_items, color=\"#7060A0\", linestyle=\":\", alpha=0.7)\n",
    "right.set(\n",
    "    xscale=\"log\",\n",
    "    xlabel=\"Число товаров в порядке популярности\",\n",
    "    ylabel=\"Доля покупок\",\n",
    "    title=\"Концентрация покупок\",\n",
    ")\n",
    "right.yaxis.set_major_formatter(PercentFormatter(1))\n",
    "plt.show()\n",
    "\n",
    "display(Markdown(\n",
    "    f\"Медиана длины сессии — **{lengths.median():.0f} просмотра**, максимум — \"\n",
    "    f\"**{lengths.max():,}**. Длинные сессии сохранены, а на графике их хвост объединён \"\n",
    "    f\"в один столбец. Топ-1% товаров даёт **{head_purchase_share:.1%}** покупок. \"\n",
    "    \"Это основание включить популярность в сравнение и измерить, сколько каталога \"\n",
    "    \"покрывают персональные выдачи по сессиям.\"\n",
    "))"
