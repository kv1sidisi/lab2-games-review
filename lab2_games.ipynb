    "purchase_time = sessions[\"purchase_time\"]\n",
    "train_rows = np.flatnonzero(purchase_time.lt(\"2021-04-01\").to_numpy())\n",
    "val_rows = np.flatnonzero(\n",
    "    (purchase_time.ge(\"2021-04-01\") & purchase_time.lt(\"2021-05-01\")).to_numpy()\n",
    ")\n",
    "test_rows = np.flatnonzero(\n",
    "    (purchase_time.ge(\"2021-05-01\") & purchase_time.lt(\"2021-06-01\")).to_numpy()\n",
    ")\n",
    "final_train_rows = np.sort(np.concatenate((train_rows, val_rows)))\n",
    "\n",
    "assert all(len(rows) > 0 for rows in (train_rows, val_rows, test_rows))\n",
    "assert len(train_rows) + len(val_rows) + len(test_rows) == len(sessions)\n",
    "assert purchase_time.iloc[train_rows].max() < purchase_time.iloc[val_rows].min()\n",
    "assert purchase_time.iloc[val_rows].max() < purchase_time.iloc[test_rows].min()\n",
    "\n",
    "periods = pd.DataFrame([\n",
    "    {\n",
    "        \"Часть\": name,\n",
    "        \"Сессий\": len(rows),\n",
    "        \"Первая покупка\": purchase_time.iloc[rows].min().date(),\n",
    "        \"Последняя покупка\": purchase_time.iloc[rows].max().date(),\n",
    "    }\n",
    "    for name, rows in (\n",
    "        (\"Обучение\", train_rows),\n",
    "        (\"Валидация\", val_rows),\n",
    "        (\"Тест\", test_rows),\n",
    "    )\n",
    "]).set_index(\"Часть\")\n",
    "display(periods)"
   ]
  },
