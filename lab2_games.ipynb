    "def ranking_metrics(recommendations, targets):\n",
    "    hits = recommendations == targets[:, None]\n",
    "    discounts = 1.0 / np.log2(np.arange(2, K + 2))\n",
    "    return pd.DataFrame({\n",
    "        \"Precision@10\": hits.mean(axis=1),\n",
    "        \"Recall@10\": hits.any(axis=1).astype(np.float64),\n",
    "        \"NDCG@10\": (hits * discounts).sum(axis=1),\n",
    "    })\n",
    "\n",
    "def novelty_at_k(recommendations):\n",
    "    recipients = np.bincount(recommendations.ravel())\n",
    "    return float(np.log2(len(recommendations) / recipients[recommendations]).mean())\n",
    "\n",
    "def check_recommendations(recommendations, context, allowed):\n",
    "    assert recommendations.shape == (context.shape[0], K)\n",
    "    assert ((recommendations >= 0) & (recommendations < n_items)).all()\n",
    "    assert allowed[recommendations].all()\n",
    "    assert (np.diff(np.sort(recommendations, axis=1), axis=1) > 0).all()\n",
    "    rows = np.repeat(np.arange(len(recommendations)), K)\n",
    "    assert not np.asarray(context[rows, recommendations.ravel()]).any()\n",
    "\n",
    "examples = np.tile(np.arange(K), (3, 1))\n",
    "example_metrics = ranking_metrics(examples, np.array([0, 1, K]))\n",
    "assert np.allclose(example_metrics[\"Precision@10\"], [0.1, 0.1, 0])\n",
    "assert np.allclose(example_metrics[\"Recall@10\"], [1, 1, 0])\n",
    "assert np.allclose(example_metrics[\"NDCG@10\"], [1, 1 / np.log2(3), 0])\n",
    "assert np.isclose(novelty_at_k(np.array([[0, 1], [0, 1]])), 0)\n",
    "assert np.isclose(novelty_at_k(np.array([[0, 1], [0, 2]])), 0.5)\n",
    "print(\"Проверки метрик прошли: первое и второе места, промах, 0 и 0,5 бита новизны.\")"
   ]
  },
