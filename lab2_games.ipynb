    "history_stats = views.groupby(\"session_id\").agg(\n",
    "    n_views=(\"item_id\", \"size\"),\n",
    "    n_items_viewed=(\"item_id\", \"nunique\"),\n",
    "    first_view=(\"date\", \"min\"),\n",
    "    last_view=(\"date\", \"max\"),\n",
    ")\n",
    "sessions = (\n",
    "    purchases.set_index(\"session_id\", verify_integrity=True)\n",
    "    .rename(columns={\"item_id\": \"target_item\", \"date\": \"purchase_time\"})\n",
    "    .join(history_stats)\n",
    "    .sort_index()\n",
    ")\n",
    "\n",
    "assert len(sessions) == 1_000_000\n",
    "assert history_stats.index.difference(sessions.index).empty\n",
    "assert sessions[\"n_views\"].notna().all()\n",
    "assert views[\"date\"].notna().all() and sessions[\"purchase_time\"].notna().all()\n",
    "assert sessions[\"last_view\"].le(sessions[\"purchase_time\"]).all()\n",
    "assert not views[\"item_id\"].eq(views[\"session_id\"].map(sessions[\"target_item\"])).any()\n",
    "\n",
    "item_ids = np.sort(features[\"item_id\"].unique())\n",
    "item_index = pd.Index(item_ids)\n",
    "n_items = len(item_ids)\n",
    "assert views[\"item_id\"].isin(item_index).all()\n",
    "assert sessions[\"target_item\"].isin(item_index).all()\n",
    "\n",
    "products_per_session = sessions[\"n_items_viewed\"]\n",
    "repeated_views = len(views) - int(products_per_session.sum())\n",
    "density = (products_per_session.sum() + len(sessions)) / (len(sessions) * n_items)\n",
    "print(f\"Сессий: {len(sessions):,}. Товаров: {n_items:,}. Просмотров: {len(views):,}.\")\n",
    "print(f\"Повторных просмотров товара в той же сессии: {repeated_views:,}.\")\n",
    "print(f\"Заполнено {density:.4%} матрицы «сессия × товар» с покупками.\")\n",
    "\n",
    "sessions[\"duration_min\"] = (\n",
    "    (sessions[\"last_view\"] - sessions[\"first_view\"]).dt.total_seconds() / 60\n",
    ")\n",
    "eda = sessions[[\"n_views\", \"duration_min\"]].describe(percentiles=[0.5, 0.95, 0.99])\n",
    "display(eda.loc[[\"min\", \"50%\", \"95%\", \"99%\", \"max\"]].rename(\n",
    "    columns={\"n_views\": \"Просмотров\", \"duration_min\": \"Минут от первого до последнего просмотра\"}\n",
    ").round(2))"
   ]
