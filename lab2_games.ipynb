    "archive_candidates = (\n",
    "    Path(\"dressipi_recsys2022.zip\"),\n",
    "    Path(\"lab02_submission/data/dressipi_recsys2022.zip\"),\n",
    ")\n",
    "archive_path = next((path for path in archive_candidates if path.is_file()), None)\n",
    "if archive_path is None:\n",
    "    raise FileNotFoundError(\n",
    "        \"Положите dressipi_recsys2022.zip рядом с ноутбуком. Ссылка на архив указана в начале.\"\n",
    "    )\n",
    "\n",
    "expected_sha256 = \"4ed5fdc82482952173e73204c9a73bbd7c141cb494dab8d1cd5bd8a5ad95c6f4\"\n",
    "with archive_path.open(\"rb\") as stream:\n",
    "    archive_sha256 = file_digest(stream, \"sha256\").hexdigest()\n",
    "if archive_sha256 != expected_sha256:\n",
    "    raise ValueError(f\"Контрольная сумма {archive_path} отличается от зафиксированной версии.\")\n",
    "\n",
    "id_types = {\"session_id\": \"int32\", \"item_id\": \"int32\"}\n",
    "with ZipFile(archive_path) as archive:\n",
    "    with archive.open(\"dressipi_recsys2022/train_sessions.csv\") as stream:\n",
    "        views = pd.read_csv(stream, dtype=id_types)\n",
    "    with archive.open(\"dressipi_recsys2022/train_purchases.csv\") as stream:\n",
    "        purchases = pd.read_csv(stream, dtype=id_types)\n",
    "    with archive.open(\"dressipi_recsys2022/item_features.csv\") as stream:\n",
    "        features = pd.read_csv(stream, dtype=\"int32\")\n",
    "\n",
    "quality = pd.DataFrame(\n",
    "    [\n",
    "        (name, len(table), int(table.isna().sum().sum()), int(table.duplicated().sum()))\n",
    "        for name, table in (\n",
    "            (\"Просмотры\", views),\n",
    "            (\"Покупки\", purchases),\n",
    "            (\"Признаки\", features),\n",
    "        )\n",
    "    ],\n",
    "    columns=[\"Таблица\", \"Строк\", \"Пропусков\", \"Точных дублей\"],\n",
    ").set_index(\"Таблица\")\n",
    "display(quality)\n",
    "assert quality[\"Пропусков\"].eq(0).all()\n",
    "\n",
    "views = views.drop_duplicates()\n",
    "purchases = purchases.drop_duplicates()\n",
    "features = features.drop_duplicates()\n",
    "views[\"date\"] = pd.to_datetime(views[\"date\"], format=\"mixed\")\n",
    "purchases[\"date\"] = pd.to_datetime(purchases[\"date\"], format=\"mixed\")"
   ]
