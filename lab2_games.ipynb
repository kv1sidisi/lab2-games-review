    "        **validation_metrics(recommendations),\n",
    "    }\n",
    "\n",
    "with threadpool_limits(limits=4, user_api=\"blas\"):\n",
    "    svd_trials = [svd_trial(rank, False) for rank in (16, 32, 64, 128)]\n",
    "    best_binary = max(svd_trials, key=lambda trial: (trial[\"NDCG@10\"], -trial[\"Факторов\"]))\n",
    "    svd_trials.append(svd_trial(best_binary[\"Факторов\"], True))\n",
    "\n",
    "svd_table = pd.DataFrame(svd_trials).sort_values(\n",
    "    [\"NDCG@10\", \"Факторов\", \"L2-нормировка\"],\n",
