    "else:\n",
    "    relation = \"выше\" if svd_gap_pp > 0 else \"ниже\"\n",
    "    neighbor_comparison = f\"У ItemKNN NDCG@10 {relation} на {abs(svd_gap_pp):.2f} п. п.\"\n",
