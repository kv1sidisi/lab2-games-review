    "def mostpop_recommend(context, popularity, allowed):\n",
    "    scores = popularity.astype(np.float32)\n",
    "    return recommend(\n",
    "        context, lambda batch: np.broadcast_to(scores, batch.shape), popularity, allowed\n",
    "    )\n",
    "\n",
    "def fit_itemknn(gram, neighbors):\n",
    "    counts = gram.diagonal()\n",
    "    index_chunks, similarity_chunks, offsets = [], [], [0]\n",
    "    for target in range(gram.shape[1]):\n",
    "        start, end = gram.indptr[target:target + 2]\n",
    "        source = gram.indices[start:end]\n",
    "        cooccurrence = gram.data[start:end]\n",
    "        different = source != target\n",
    "        source, cooccurrence = source[different], cooccurrence[different]\n",
    "        similarities = cooccurrence / np.sqrt(counts[source] * counts[target])\n",
    "        nearest = np.lexsort((source, -similarities))[:neighbors]\n",
    "        index_chunks.append(source[nearest])\n",
    "        similarity_chunks.append(similarities[nearest])\n",
    "        offsets.append(offsets[-1] + len(nearest))\n",
    "    return csc_matrix(\n",
    "        (np.concatenate(similarity_chunks), np.concatenate(index_chunks), offsets),\n",
    "        shape=gram.shape,\n",
    "    ).tocsr()\n",
    "\n",
    "def svd_recommend(interactions, context, rank, l2_rows, popularity, allowed):\n",
    "    fit_matrix = normalize(interactions) if l2_rows else interactions\n",
    "    model = TruncatedSVD(n_components=rank, random_state=SEED)\n",
    "    model.fit(fit_matrix)\n",
    "\n",
    "    def score(batch):\n",
    "        projection_input = normalize(batch) if l2_rows else batch\n",
    "        return model.transform(projection_input) @ model.components_\n",
    "\n",
    "    return recommend(context, score, popularity, allowed)\n",
    "\n",
    "def content_scores(batch):\n",
    "    profile = normalize(batch @ feature_tfidf)\n",
    "    return (profile @ feature_tfidf.T).toarray()"
   ]
  },
