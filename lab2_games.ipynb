    "view_rows = sessions.index.get_indexer(views[\"session_id\"])\n",
    "view_columns = item_index.get_indexer(views[\"item_id\"])\n",
    "target_index = item_index.get_indexer(sessions[\"target_item\"])\n",
    "assert (view_rows >= 0).all() and (view_columns >= 0).all() and (target_index >= 0).all()\n",
    "\n",
    "history = csr_matrix(\n",
    "    (np.ones(len(views), dtype=np.float32), (view_rows, view_columns)),\n",
    "    shape=(len(sessions), n_items),\n",
    ")\n",
    "history.data.fill(1)\n",
    "assert history.nnz == products_per_session.sum()\n",
    "\n",
    "feature_codes, feature_vocabulary = pd.factorize(\n",
    "    pd.MultiIndex.from_frame(features[[\"feature_category_id\", \"feature_value_id\"]]),\n",
    "    sort=True,\n",
    ")\n",
    "item_features = csr_matrix(\n",
    "    (np.ones(len(features), dtype=np.float32), (\n",
    "        item_index.get_indexer(features[\"item_id\"]), feature_codes\n",
    "    )),\n",
    "    shape=(n_items, len(feature_vocabulary)),\n",
    ")\n",
    "feature_tfidf = TfidfTransformer().fit_transform(item_features).tocsr()\n",
    "\n",
    "def training_data(rows):\n",
    "    targets = target_index[rows]\n",
    "    purchases_in_fold = csr_matrix(\n",
    "        (np.ones(len(rows), dtype=np.float32), (np.arange(len(rows)), targets)),\n",
    "        shape=(len(rows), n_items),\n",
    "    )\n",
    "    interactions = (history[rows] + purchases_in_fold).tocsr()\n",
    "    interactions.data.fill(1)\n",
    "    support = np.asarray(interactions.sum(axis=0)).ravel()\n",
    "    popularity = np.bincount(targets, minlength=n_items)\n",
    "    return interactions, support, popularity"
   ]
  },
